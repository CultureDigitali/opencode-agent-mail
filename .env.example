# ── OpenCode Agent Mail — env template ──────────────────────────
# Copia in .env o imposta come variabili Utente di sistema
# MAI committare password reali

# Dove tenere identita e stato (default: ~/.config/opencode)
# Utile per test o profili multipli sulla stessa macchina
# AGENT_MAIL_STATE_DIR=/percorso/alternativo

# Scelta esplicita del provider: gmail | resend | generic
# Senza questo, se piu provider sono configurati viene usato gmail
# (ordine di rilevamento: gmail -> resend -> generic) e viene emessa
# una diagnostica in mail_status
# MAIL_PROVIDER=gmail

# Gmail free (consigliato per partire, 0€, 500 mail/giorno)
GMAIL_USER=your.agent@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
# 16 chars senza spazi, generata su https://myaccount.google.com/apppasswords
# Richiede 2FA attiva sull'account agente

# Dove ricevi i report (tua inbox personale)
MAIL_TO=your.personal@gmail.com

# Identita (alternativa a agent-identity.json)
# Precedenza campo-per-campo: env > file > default
# AGENT_ID=culture-agent-pc-01
# AGENT_DISPLAY_NAME=Culture Agent PC
# AGENT_SIGNATURE=-- Culture Agent PC | OpenCode
# AGENT_INSTANCE_HOST=Luigi-PC

# Resend: per usarlo imposta MAIL_PROVIDER=resend
# RESEND_SMTP_PASS=re_xxx

# SMTP generico (es. server aziendale): MAIL_PROVIDER=generic
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true = TLS implicito (tipicamente porta 465)
# SMTP_USER=utente         # obbligatorio se imposti SMTP_PASS
# SMTP_PASS=password
# SMTP_ALLOW_ANONYMOUS=true  # richiesto per usare SMTP_HOST senza autenticazione

# Limite oratorio di invii, persistente su disco per identita (0 = disattivato)
# MAIL_MAX_PER_HOUR=20

# IMAP per mail_inbox: se omesso riusa GMAIL_USER / GMAIL_APP_PASSWORD
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=your.agent@gmail.com
# IMAP_PASS=abcdefghijklmnop
