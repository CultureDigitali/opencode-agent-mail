{
  "name": "opencode-agent-mail",
  "version": "1.0.0",
  "description": "One inbox. Infinite agents. The revolutionary email identity plugin for OpenCode — give every agent a soul, keep one Gmail.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/unit.test.mjs test/ratelimit.test.mjs test/integration.test.mjs test/imap.test.mjs test/loader.compat.test.mjs test/gate.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "email",
    "agent-identity",
    "gmail",
    "resend",
    "ai-agents",
    "automation",
    "signature",
    "multi-agent"
  ],
  "author": "Culture Agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CultureDigitali/opencode-agent-mail.git"
  },
  "homepage": "https://github.com/CultureDigitali/opencode-agent-mail#readme",
  "bugs": "https://github.com/CultureDigitali/opencode-agent-mail/issues",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.0"
  },
  "dependencies": {
    "imapflow": "^2.2.1",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
